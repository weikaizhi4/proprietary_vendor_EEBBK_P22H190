        <SlotId>0</SlotId>
        <SensorName>ov5675_h180</SensorName>
        <Facing>BACK</Facing>
        <Orientation>90</Orientation>
        <Resource_cost>100</Resource_cost>
        <SensorRole></SensorRole>
        <VCM>
            <AfName>gt9772</AfName>
            <Mode>0</Mode>
        </VCM>
        <OTP>
            <E2prom>
                <OtpName>general</OtpName>
                <I2cAddr>0xa0</I2cAddr>
                <E2promNum>0</E2promNum>
                <E2promSize>2785</E2promSize>
            </E2prom>
        </OTP>
        <TuningParameter>
            <TuningName>ov5675_h180_back</TuningName>
        </TuningParameter>
      </CameraModuleCfg>
     
